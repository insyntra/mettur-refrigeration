{
    "name": "mettur-refrigeration",
    "main": "src/worker.js",
    "compatibility_date": "2025-09-01",
    "assets": {
      "directory": ".",
      "binding": "ASSETS",
      "not_found_handling": "404-page",
      "run_worker_first": ["/api/*"]
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "metturtechrefrigeration-reviews",
        "database_id": "440403d8-bd69-4600-8cfc-2d5b7feeb04c"
      }
    ]
  }